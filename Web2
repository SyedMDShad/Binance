<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PostMaster AI Studio Ultimate</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Oswald&family=Roboto+Slab&family=Dancing+Script&family=Bangla+Sangam+MN&display=swap" rel="stylesheet">
    <!-- Tesseract JS for OCR -->
    <script src='https://unpkg.com/tesseract.js@v2.1.0/dist/tesseract.min.js'></script>
    <!-- Markdown Parser -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

    <style>
        body { font-family: 'Inter', sans-serif; background-color: #0f172a; color: #e2e8f0; }
        .panel-bg { background-color: #1e293b; border-color: #334155; }
        .tool-btn { @apply p-3 rounded-lg transition duration-200 text-gray-400 hover:text-white hover:bg-slate-700 relative group; }
        .tool-btn.active { @apply bg-blue-600 text-white shadow-lg shadow-blue-500/30; }
        .checkerboard {
            background-color: #262626;
            background-image: linear-gradient(45deg, #333 25%, transparent 25%), linear-gradient(-45deg, #333 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #333 75%), linear-gradient(-45deg, transparent 75%, #333 75%);
            background-size: 20px 20px;
        }
        input[type="range"] { -webkit-appearance: none; background: transparent; cursor: pointer; }
        input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; height: 14px; width: 14px; border-radius: 50%; background: #3b82f6; margin-top: -5px; }
        input[type="range"]::-webkit-slider-runnable-track { width: 100%; height: 4px; background: #475569; border-radius: 2px; }
        .loader { border: 3px solid #f3f3f3; border-top: 3px solid #3498db; border-radius: 50%; width: 20px; height: 20px; animation: spin 1s linear infinite; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        
        /* Chat Bubble Styles */
        .chat-bubble { max-width: 85%; padding: 10px; border-radius: 12px; font-size: 0.85rem; line-height: 1.4; margin-bottom: 10px; }
        .chat-user { background-color: #3b82f6; color: white; margin-left: auto; border-bottom-right-radius: 2px; }
        .chat-ai { background-color: #334155; color: #e2e8f0; margin-right: auto; border-bottom-left-radius: 2px; }
    </style>
</head>
<body class="h-screen flex flex-col overflow-hidden">

    <!-- Top Bar -->
    <header class="h-14 panel-bg border-b flex items-center justify-between px-4 z-30 select-none">
        <div class="flex items-center gap-3">
            <div class="bg-gradient-to-br from-purple-600 to-blue-600 p-1.5 rounded text-white font-bold text-lg shadow-lg"><i class="fa-solid fa-brain"></i></div>
            <span class="font-bold text-lg tracking-wide text-white">PostMaster <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-blue-400">Ultimate</span></span>
        </div>
        
        <div class="flex items-center gap-3">
            <div class="hidden md:flex bg-slate-800 rounded-lg p-1 border border-slate-700">
                <button onclick="switchTab('props')" id="tab-props" class="px-3 py-1 rounded text-xs font-medium bg-slate-600 text-white transition">Properties</button>
                <button onclick="switchTab('chat')" id="tab-chat" class="px-3 py-1 rounded text-xs font-medium text-slate-400 hover:text-white transition flex items-center gap-1"><i class="fa-solid fa-message"></i> AI Chat</button>
            </div>

            <button onclick="openSettings()" class="text-slate-400 hover:text-white transition text-sm flex items-center gap-2 px-3 py-1.5 rounded hover:bg-slate-800 border border-transparent hover:border-slate-700">
                <i class="fa-solid fa-key"></i> Keys
            </button>
            <div class="h-6 w-px bg-slate-700"></div>
            <div class="relative group">
                <button class="bg-blue-600 hover:bg-blue-500 text-white px-5 py-1.5 rounded shadow-lg shadow-blue-500/20 text-sm font-medium flex items-center gap-2 transition">
                    <i class="fa-solid fa-download"></i> Export
                </button>
                <div class="absolute right-0 top-full mt-2 w-56 panel-bg rounded-lg shadow-2xl border border-slate-700 hidden group-hover:block p-2">
                    <button onclick="downloadImage(1)" class="w-full text-left px-3 py-2 text-sm text-slate-300 hover:bg-slate-700 rounded flex justify-between">Standard <span>1x</span></button>
                    <button onclick="downloadImage(2)" class="w-full text-left px-3 py-2 text-sm text-slate-300 hover:bg-slate-700 rounded flex justify-between">High Res (2K) <span class="text-xs bg-blue-900 text-blue-300 px-1 rounded">HD</span></button>
                    <button onclick="downloadImage(4)" class="w-full text-left px-3 py-2 text-sm text-yellow-400 hover:bg-slate-700 rounded flex justify-between font-bold">Ultra Res (4K) <span class="text-xs bg-yellow-900 text-yellow-300 px-1 rounded">PRO</span></button>
                </div>
            </div>
        </div>
    </header>

    <div class="flex flex-1 overflow-hidden">
        <!-- Left Toolbar -->
        <aside class="w-16 panel-bg border-r flex flex-col items-center py-4 gap-3 z-20">
            <button onclick="triggerUpload()" class="tool-btn" title="Upload Image"><i class="fa-solid fa-folder-open text-xl"></i></button>
            <input type="file" id="fileInput" accept="image/*" class="hidden">
            <div class="w-8 h-px bg-slate-700 my-1"></div>
            <button onclick="setMode('select')" id="btn-select" class="tool-btn active" title="Move Tool (V)"><i class="fa-solid fa-arrow-pointer text-xl"></i></button>
            <button onclick="setMode('crop')" id="btn-crop" class="tool-btn" title="Crop Tool (C)"><i class="fa-solid fa-crop-simple text-xl"></i></button>
            <button onclick="setMode('brush')" id="btn-brush" class="tool-btn" title="Brush Tool (B)"><i class="fa-solid fa-paintbrush text-xl"></i></button>
            <div class="w-8 h-px bg-slate-700 my-1"></div>
            <button onclick="addTextLayer()" class="tool-btn" title="Add Text (T)"><i class="fa-solid fa-font text-xl"></i></button>
            <button onclick="addCoverBox()" class="tool-btn" title="Smart Cover (Box)"><i class="fa-solid fa-square-full text-xl"></i></button>
            <button onclick="addBlurBox()" class="tool-btn text-red-400 hover:text-red-300" title="Privacy Blur"><i class="fa-solid fa-droplet-slash text-xl"></i></button>
            <button onclick="runOCR()" class="tool-btn text-purple-400 hover:text-purple-300 mt-auto" title="AI Text Scan (OCR)"><i class="fa-solid fa-expand text-xl"></i></button>
        </aside>

        <!-- Main Canvas Area -->
        <main class="flex-1 bg-slate-900 relative overflow-hidden flex flex-col">
            <div id="canvasToolbar" class="h-10 panel-bg border-b flex items-center px-4 justify-between text-xs text-slate-400">
                <div class="flex items-center gap-4">
                    <span id="zoomLevel">100%</span>
                    <button onclick="resetView()" class="hover:text-white"><i class="fa-solid fa-compress"></i> Fit</button>
                    <label class="flex items-center gap-2 cursor-pointer hover:text-white"><input type="checkbox" id="bgToggle" class="rounded bg-slate-700 border-none" checked onchange="toggleCanvasBg()"> Checkerboard</label>
                </div>
                <div class="flex items-center gap-2" id="brushSettings" style="display:none;">
                    <span>Size:</span><input type="range" id="brushSize" min="1" max="50" value="5" class="w-24">
                    <input type="color" id="brushColor" value="#ff0000" class="bg-transparent border-none w-6 h-6">
                </div>
            </div>

            <div class="flex-1 overflow-auto flex items-center justify-center p-8 relative checkerboard" id="canvasWrapper">
                <canvas id="editorCanvas" class="shadow-2xl shadow-black ring-1 ring-slate-700"></canvas>
                <div id="welcomeMsg" class="absolute inset-0 flex flex-col items-center justify-center text-slate-600 pointer-events-none z-0">
                    <i class="fa-solid fa-photo-film text-6xl mb-4 opacity-50"></i>
                    <p class="text-xl font-light">Drag & Drop or Upload Image</p>
                </div>
                <div id="ocrLoader" class="absolute inset-0 bg-black/80 hidden flex flex-col items-center justify-center z-50 text-white backdrop-blur-sm">
                    <div class="loader mb-4 border-t-purple-500"></div><p>AI Scanning Text...</p>
                </div>
            </div>
        </main>

        <!-- Right Panel (Properties & AI Chat) -->
        <aside class="w-80 panel-bg border-l flex flex-col z-20 overflow-hidden relative">
            
            <!-- Properties Tab Content -->
            <div id="panel-props" class="flex-1 overflow-y-auto p-4 space-y-6">
                <div id="propEmpty" class="text-center py-10 opacity-50">
                    <p class="text-sm">Select a layer to edit or switch to AI Chat</p>
                </div>

                <div id="propText" class="space-y-4 hidden">
                    <div class="bg-slate-800 p-3 rounded-lg border border-slate-700 space-y-2">
                        <label class="text-xs text-slate-400 font-bold uppercase">AI Actions</label>
                        <div class="grid grid-cols-2 gap-2">
                            <button onclick="aiAction('rewrite')" class="text-xs bg-purple-900/50 hover:bg-purple-900 text-purple-200 border border-purple-800 px-2 py-1.5 rounded transition">Rewrite</button>
                            <button onclick="aiAction('translate')" class="text-xs bg-blue-900/50 hover:bg-blue-900 text-blue-200 border border-blue-800 px-2 py-1.5 rounded transition">To Bangla</button>
                            <button onclick="aiAction('grammar')" class="text-xs bg-green-900/50 hover:bg-green-900 text-green-200 border border-green-800 px-2 py-1.5 rounded transition">Fix Grammar</button>
                            <button onclick="aiAction('viral')" class="text-xs bg-orange-900/50 hover:bg-orange-900 text-orange-200 border border-orange-800 px-2 py-1.5 rounded transition">Make Viral</button>
                        </div>
                    </div>

                    <div>
                        <label class="text-xs text-slate-400 block mb-1">Content</label>
                        <textarea id="textInput" rows="3" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-sm focus:border-blue-500 outline-none text-slate-200"></textarea>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="text-xs text-slate-400 block mb-1">Font</label>
                            <select id="fontFamily" class="w-full bg-slate-900 border border-slate-700 rounded p-1.5 text-xs text-white">
                                <option value="'Inter', sans-serif">Inter UI</option>
                                <option value="'Oswald', sans-serif">Oswald Bold</option>
                                <option value="'Roboto Slab', serif">Serif Slab</option>
                                <option value="'Bangla Sangam MN', sans-serif">Bangla Standard</option>
                                <option value="'Dancing Script', cursive">Handwriting</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-xs text-slate-400 block mb-1">Size</label>
                            <input type="number" id="fontSize" class="w-full bg-slate-900 border border-slate-700 rounded p-1.5 text-xs text-white" min="10">
                        </div>
                    </div>

                    <div class="flex gap-2 items-center">
                         <div class="flex-1">
                            <label class="text-xs text-slate-400 block mb-1">Color</label>
                            <div class="flex gap-2 bg-slate-900 border border-slate-700 rounded p-1">
                                <input type="color" id="textColor" class="w-6 h-6 bg-transparent border-none cursor-pointer">
                                <input type="text" id="textColorHex" class="bg-transparent text-xs w-full outline-none text-slate-300 uppercase pt-1">
                            </div>
                        </div>
                        <button id="boldToggle" class="h-9 w-9 mt-4 bg-slate-800 border border-slate-700 rounded hover:bg-slate-700 text-slate-300"><i class="fa-solid fa-bold"></i></button>
                    </div>

                    <div class="pt-2 border-t border-slate-700">
                        <label class="flex items-center gap-2 mb-2"><input type="checkbox" id="textBgEnabled" class="rounded bg-slate-700 border-none"><span class="text-xs text-slate-300">Background Box</span></label>
                        <div class="flex gap-2">
                            <input type="color" id="textBgColor" class="w-full h-6 bg-slate-900 border border-slate-700 rounded cursor-pointer">
                            <button onclick="pickColor('textBg')" class="bg-slate-800 border border-slate-700 px-2 rounded hover:bg-slate-700"><i class="fa-solid fa-eye-dropper text-xs text-slate-400"></i></button>
                        </div>
                    </div>
                </div>

                <div id="propBox" class="space-y-4 hidden">
                    <p class="text-xs text-slate-400">Cover Box Properties</p>
                    <div>
                        <label class="text-xs text-slate-400 block mb-1">Fill Color</label>
                        <div class="flex gap-2">
                            <input type="color" id="boxColor" class="flex-1 h-8 bg-slate-900 border border-slate-700 rounded cursor-pointer">
                            <button onclick="pickColor('box')" class="flex-1 bg-slate-800 border border-slate-700 rounded text-xs hover:bg-slate-700 flex items-center justify-center gap-1 text-slate-300"><i class="fa-solid fa-eye-dropper"></i> Pick</button>
                        </div>
                    </div>
                </div>

                <div id="propBlur" class="space-y-4 hidden">
                    <p class="text-xs text-slate-400">Blur Intensity</p>
                    <input type="range" id="blurAmount" min="2" max="30" class="w-full">
                </div>

                <div class="pt-6 border-t border-slate-700">
                    <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">Global Adjustments</h4>
                    <div class="space-y-4">
                        <div class="flex justify-between text-xs text-slate-400 mb-1"><span>Brightness</span> <span id="val-brightness">100%</span></div>
                        <input type="range" oninput="updateFilter('brightness', this.value)" min="0" max="200" value="100" class="w-full">
                        <div class="flex justify-between text-xs text-slate-400 mb-1"><span>Contrast</span> <span id="val-contrast">100%</span></div>
                        <input type="range" oninput="updateFilter('contrast', this.value)" min="0" max="200" value="100" class="w-full">
                        <div class="flex gap-2">
                            <button onclick="toggleFilter('invert')" class="flex-1 bg-slate-800 border border-slate-700 py-1.5 rounded text-xs hover:bg-slate-700">Invert</button>
                            <button onclick="toggleFilter('grayscale')" class="flex-1 bg-slate-800 border border-slate-700 py-1.5 rounded text-xs hover:bg-slate-700">B&W</button>
                        </div>
                    </div>
                </div>

                <div class="pt-6 border-t border-slate-700">
                    <div class="flex justify-between items-center mb-2">
                         <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Actions</h4>
                         <button onclick="deleteActiveLayer()" class="text-red-400 hover:text-red-300 text-xs"><i class="fa-solid fa-trash"></i> Delete</button>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <button onclick="moveLayer('up')" class="bg-slate-800 border border-slate-700 py-1.5 rounded text-xs hover:bg-slate-700">Front</button>
                        <button onclick="moveLayer('down')" class="bg-slate-800 border border-slate-700 py-1.5 rounded text-xs hover:bg-slate-700">Back</button>
                    </div>
                </div>
            </div>

            <!-- AI Chat Tab Content -->
            <div id="panel-chat" class="flex-1 hidden flex flex-col h-full bg-slate-900">
                <div class="p-3 border-b border-slate-700 bg-slate-800/50 flex justify-between items-center">
                    <div class="text-xs font-semibold text-slate-300">Assistant</div>
                    <select id="aiModelSelect" class="bg-slate-900 border border-slate-700 text-xs text-white rounded px-2 py-1 outline-none">
                        <option value="gemini">Google Gemini</option>
                        <option value="openai">OpenAI (GPT)</option>
                    </select>
                </div>
                
                <div id="chatHistory" class="flex-1 overflow-y-auto p-4 space-y-3">
                    <div class="chat-bubble chat-ai">
                        Hello! I can see your canvas. Ask me to write captions, suggest hashtags, or analyze the image!
                    </div>
                </div>

                <div class="p-3 border-t border-slate-700 bg-slate-800">
                    <div class="flex gap-2 mb-2 overflow-x-auto pb-1 no-scrollbar">
                        <button onclick="quickPrompt('Write a caption for this image')" class="whitespace-nowrap bg-slate-700 hover:bg-slate-600 text-[10px] px-2 py-1 rounded text-slate-300 border border-slate-600">📝 Caption</button>
                        <button onclick="quickPrompt('Suggest 5 viral hashtags')" class="whitespace-nowrap bg-slate-700 hover:bg-slate-600 text-[10px] px-2 py-1 rounded text-slate-300 border border-slate-600">#️⃣ Hashtags</button>
                        <button onclick="quickPrompt('Describe this image in detail')" class="whitespace-nowrap bg-slate-700 hover:bg-slate-600 text-[10px] px-2 py-1 rounded text-slate-300 border border-slate-600">👁️ Analyze</button>
                    </div>
                    <div class="relative">
                        <input type="text" id="chatInput" placeholder="Ask AI..." class="w-full bg-slate-900 border border-slate-700 rounded-full px-4 py-2 text-sm text-white focus:border-blue-500 outline-none pr-10" onkeypress="if(event.key==='Enter') sendChat()">
                        <button onclick="sendChat()" class="absolute right-1 top-1 bg-blue-600 hover:bg-blue-500 text-white w-8 h-8 rounded-full flex items-center justify-center transition"><i class="fa-solid fa-paper-plane text-xs"></i></button>
                    </div>
                </div>
            </div>

        </aside>
    </div>

    <!-- Settings Modal -->
    <div id="settingsModal" class="fixed inset-0 bg-black/80 hidden z-50 flex items-center justify-center backdrop-blur-sm">
        <div class="bg-slate-800 w-96 rounded-xl border border-slate-600 shadow-2xl p-6">
            <h3 class="text-xl font-bold text-white mb-4"><i class="fa-solid fa-key text-blue-500"></i> API Keys</h3>
            
            <div class="space-y-4">
                <div>
                    <label class="text-xs text-purple-400 block mb-1 font-bold">Google Gemini API Key</label>
                    <input type="password" id="keyGemini" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-sm text-white focus:border-purple-500 outline-none placeholder-slate-600" placeholder="AIzaSy...">
                    <p class="text-[10px] text-slate-500 mt-1">Recommended for Image Analysis (Vision).</p>
                </div>
                <div>
                    <label class="text-xs text-green-400 block mb-1 font-bold">OpenAI API Key (ChatGPT)</label>
                    <input type="password" id="keyOpenAI" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-sm text-white focus:border-green-500 outline-none placeholder-slate-600" placeholder="sk-...">
                    <p class="text-[10px] text-slate-500 mt-1">May require proxy/server due to browser restrictions.</p>
                </div>
            </div>
            
            <div class="flex justify-end gap-3 mt-6">
                <button onclick="closeSettings()" class="text-slate-400 hover:text-white text-sm">Cancel</button>
                <button onclick="saveSettings()" class="bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded text-sm font-medium">Save Keys</button>
            </div>
        </div>
    </div>

    <!-- AI Loading Float -->
    <div id="aiLoader" class="fixed top-20 left-1/2 transform -translate-x-1/2 bg-slate-800 text-white px-4 py-2 rounded-full shadow-xl border border-blue-500/50 flex items-center gap-3 z-50 hidden">
        <div class="loader border-t-blue-500 w-4 h-4"></div><span class="text-sm" id="aiStatusText">AI is thinking...</span>
    </div>

    <script>
        // --- Core Variables ---
        const canvas = document.getElementById('editorCanvas');
        const ctx = canvas.getContext('2d');
        const fileInput = document.getElementById('fileInput');
        
        let img = new Image();
        let layers = []; 
        let activeLayerIndex = -1;
        let mode = 'select'; 
        let isDragging = false;
        let dragTarget = null;
        let dragStart = {x:0, y:0};
        
        // Brush
        let isDrawing = false;
        
        // Keys
        let keys = { gemini: localStorage.getItem('pm_gemini') || '', openai: localStorage.getItem('pm_openai') || '' };
        
        // Filters
        let filters = { brightness: 100, contrast: 100, invert: 0, grayscale: 0 };
        let isPicking = false; let pickTarget = null;

        // Init
        document.getElementById('keyGemini').value = keys.gemini;
        document.getElementById('keyOpenAI').value = keys.openai;

        // --- Functions ---

        function resizeCanvas(w, h) {
            canvas.width = w; canvas.height = h;
            const wrapper = document.getElementById('canvasWrapper');
            const scale = Math.min((wrapper.clientWidth-40)/w, (wrapper.clientHeight-40)/h, 1);
            canvas.style.width = `${w*scale}px`; canvas.style.height = `${h*scale}px`;
            draw();
        }

        fileInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if(!file) return;
            const reader = new FileReader();
            reader.onload = (evt) => {
                img = new Image();
                img.onload = () => { layers = []; activeLayerIndex = -1; resizeCanvas(img.width, img.height); document.getElementById('welcomeMsg').style.display = 'none'; };
                img.src = evt.target.result;
            };
            reader.readAsDataURL(file);
        });

        function triggerUpload() { fileInput.click(); }
        function setMode(m) {
            mode = m;
            document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
            document.getElementById(`btn-${m}`).classList.add('active');
            document.getElementById('brushSettings').style.display = m === 'brush' ? 'flex' : 'none';
            canvas.style.cursor = m === 'select' ? 'default' : (m === 'brush' ? 'crosshair' : 'default');
            draw();
        }

        // --- Drawing ---
        function draw() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.save();
            ctx.filter = `brightness(${filters.brightness}%) contrast(${filters.contrast}%) invert(${filters.invert}%) grayscale(${filters.grayscale}%)`;
            if(img.src) ctx.drawImage(img, 0, 0);
            ctx.restore();

            layers.forEach((l, idx) => {
                ctx.save();
                if (l.type === 'brush') {
                    ctx.lineCap = 'round'; ctx.lineJoin = 'round'; ctx.lineWidth = l.size; ctx.strokeStyle = l.color;
                    ctx.beginPath();
                    if(l.points.length>0) { ctx.moveTo(l.points[0].x, l.points[0].y); for(let i=1;i<l.points.length;i++) ctx.lineTo(l.points[i].x, l.points[i].y); ctx.stroke(); }
                } else if (l.type === 'box') {
                    ctx.fillStyle = l.color; ctx.fillRect(l.x, l.y, l.w, l.h);
                } else if (l.type === 'blur') {
                    ctx.save(); ctx.beginPath(); ctx.rect(l.x, l.y, l.w, l.h); ctx.clip();
                    ctx.filter = `blur(${l.blur}px)`; if(img.src) ctx.drawImage(img, 0, 0); ctx.restore();
                } else if (l.type === 'text') {
                    ctx.font = `${l.bold?'bold':''} ${l.fontSize}px ${l.fontFamily}`; ctx.textBaseline = 'top';
                    const lines = l.content.split('\n'); const lh = l.fontSize * 1.2;
                    let maxW = 0; lines.forEach(t=>{const m=ctx.measureText(t); if(m.width>maxW)maxW=m.width;});
                    l.w = maxW; l.h = lines.length * lh;
                    if(l.bgEnabled){ ctx.fillStyle = l.bgColor; ctx.fillRect(l.x-5, l.y-5, l.w+10, l.h+10); }
                    ctx.fillStyle = l.color; lines.forEach((t,i)=>ctx.fillText(t, l.x, l.y+(i*lh)));
                }

                if(idx === activeLayerIndex && mode === 'select') {
                    ctx.strokeStyle = '#3b82f6'; ctx.lineWidth = 2; const p = l.type==='text'?5:0;
                    if(l.type!=='brush'){ ctx.strokeRect(l.x-p, l.y-p, l.w+p*2, l.h+p*2); ctx.fillStyle='white'; ctx.fillRect(l.x+l.w-4, l.y+l.h-4, 8, 8); }
                }
                ctx.restore();
            });
        }

        // --- Interaction ---
        function getPos(e) {
            const rect = canvas.getBoundingClientRect();
            const sx = canvas.width/rect.width; const sy = canvas.height/rect.height;
            return { x: (e.clientX-rect.left)*sx, y: (e.clientY-rect.top)*sy };
        }

        canvas.addEventListener('mousedown', (e) => {
            const pos = getPos(e);
            if(isPicking) { executePick(pos); return; }
            if(mode === 'brush') { isDrawing=true; layers.push({type:'brush', points:[{x:pos.x,y:pos.y}], size:parseInt(document.getElementById('brushSize').value), color:document.getElementById('brushColor').value}); activeLayerIndex=layers.length-1; draw(); return; }
            if(mode === 'select') {
                if(activeLayerIndex!==-1) {
                    const l = layers[activeLayerIndex];
                    if(l.type!=='brush' && pos.x>l.x+l.w-15 && pos.x<l.x+l.w+15 && pos.y>l.y+l.h-15 && pos.y<l.y+l.h+15) { isDragging=true; dragTarget='resize'; return; }
                }
                let hit = -1;
                for(let i=layers.length-1; i>=0; i--) {
                    const l = layers[i]; if(l.type==='brush')continue; const p=l.type==='text'?5:0;
                    if(pos.x>=l.x-p && pos.x<=l.x+l.w+p && pos.y>=l.y-p && pos.y<=l.y+l.h+p){ hit=i; break; }
                }
                activeLayerIndex=hit; updateUI();
                if(hit!==-1){ isDragging=true; dragTarget='move'; dragStart={x:pos.x-layers[hit].x, y:pos.y-layers[hit].y}; }
                draw();
            }
        });

        canvas.addEventListener('mousemove', (e) => {
            const pos = getPos(e);
            if(isPicking) { canvas.style.cursor='crosshair'; return; }
            if(mode==='brush' && isDrawing) { layers[layers.length-1].points.push({x:pos.x, y:pos.y}); draw(); return; }
            if(isDragging) {
                const l = layers[activeLayerIndex];
                if(dragTarget==='move') { l.x=pos.x-dragStart.x; l.y=pos.y-dragStart.y; }
                else if(dragTarget==='resize') { l.w=Math.max(10, pos.x-l.x); l.h=Math.max(10, pos.y-l.y); }
                draw();
            }
        });
        window.addEventListener('mouseup', () => { isDrawing=false; isDragging=false; });

        // --- Layers ---
        function addTextLayer() { if(!img.src) return alert("Upload Image First"); setMode('select'); layers.push({type:'text', content:'New Text', x:canvas.width/2-100, y:canvas.height/2, fontSize:40, fontFamily:"'Inter', sans-serif", color:'#ffffff', bold:true, bgEnabled:false, bgColor:'#000000', w:200, h:50}); activeLayerIndex=layers.length-1; draw(); updateUI(); }
        function addCoverBox() { if(!img.src) return alert("Upload Image First"); setMode('select'); layers.push({type:'box', x:canvas.width/2-50, y:canvas.height/2-25, w:100, h:50, color:'#1e293b'}); activeLayerIndex=layers.length-1; draw(); updateUI(); }
        function addBlurBox() { if(!img.src) return alert("Upload Image First"); setMode('select'); layers.push({type:'blur', x:canvas.width/2-50, y:canvas.height/2-25, w:100, h:50, blur:10}); activeLayerIndex=layers.length-1; draw(); updateUI(); }
        function deleteActiveLayer() { if(activeLayerIndex>-1){ layers.splice(activeLayerIndex,1); activeLayerIndex=-1; draw(); updateUI(); } }
        function moveLayer(dir) { if(activeLayerIndex===-1)return; const i=activeLayerIndex; if(dir==='up'&&i<layers.length-1){[layers[i],layers[i+1]]=[layers[i+1],layers[i]];activeLayerIndex++;} else if(dir==='down'&&i>0){[layers[i],layers[i-1]]=[layers[i-1],layers[i]];activeLayerIndex--;} draw(); }

        // --- UI ---
        function switchTab(tab) {
            document.getElementById('panel-props').classList.add('hidden');
            document.getElementById('panel-chat').classList.add('hidden');
            document.getElementById('tab-props').classList.replace('bg-slate-600','text-slate-400');
            document.getElementById('tab-chat').classList.replace('bg-slate-600','text-slate-400');
            
            document.getElementById(`panel-${tab}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`tab-${tab}`);
            activeBtn.classList.remove('text-slate-400');
            activeBtn.classList.add('bg-slate-600', 'text-white');
        }

        function updateUI() {
            if(document.getElementById('panel-chat').classList.contains('hidden') === false) return; // Don't disrupt chat
            ['propEmpty', 'propText', 'propBox', 'propBlur'].forEach(id => document.getElementById(id).classList.add('hidden'));
            if(activeLayerIndex===-1) { document.getElementById('propEmpty').classList.remove('hidden'); return; }
            const l = layers[activeLayerIndex];
            if(l.type==='text') {
                document.getElementById('propText').classList.remove('hidden');
                document.getElementById('textInput').value = l.content; document.getElementById('fontFamily').value = l.fontFamily;
                document.getElementById('fontSize').value = l.fontSize; document.getElementById('textColor').value = l.color;
                document.getElementById('textColorHex').value = l.color; document.getElementById('textBgEnabled').checked = l.bgEnabled;
                document.getElementById('textBgColor').value = l.bgColor;
            } else if(l.type==='box') {
                document.getElementById('propBox').classList.remove('hidden'); document.getElementById('boxColor').value = l.color;
            } else if(l.type==='blur') {
                document.getElementById('propBlur').classList.remove('hidden'); document.getElementById('blurAmount').value = l.blur;
            }
        }

        // --- Prop Listeners ---
        document.getElementById('textInput').addEventListener('input', e=>{if(activeLayerIndex>-1)layers[activeLayerIndex].content=e.target.value; draw();});
        document.getElementById('fontSize').addEventListener('input', e=>{if(activeLayerIndex>-1)layers[activeLayerIndex].fontSize=parseInt(e.target.value); draw();});
        document.getElementById('fontFamily').addEventListener('change', e=>{if(activeLayerIndex>-1)layers[activeLayerIndex].fontFamily=e.target.value; draw();});
        document.getElementById('textColor').addEventListener('input', e=>{if(activeLayerIndex>-1){layers[activeLayerIndex].color=e.target.value; document.getElementById('textColorHex').value=e.target.value; draw();}});
        document.getElementById('textBgEnabled').addEventListener('change', e=>{if(activeLayerIndex>-1)layers[activeLayerIndex].bgEnabled=e.target.checked; draw();});
        document.getElementById('textBgColor').addEventListener('input', e=>{if(activeLayerIndex>-1)layers[activeLayerIndex].bgColor=e.target.value; draw();});
        document.getElementById('boxColor').addEventListener('input', e=>{if(activeLayerIndex>-1)layers[activeLayerIndex].color=e.target.value; draw();});
        document.getElementById('blurAmount').addEventListener('input', e=>{if(activeLayerIndex>-1)layers[activeLayerIndex].blur=parseInt(e.target.value); draw();});

        // --- Utils ---
        function pickColor(t) { isPicking=true; pickTarget=t; }
        function executePick(pos) {
            const p = ctx.getImageData(pos.x, pos.y, 1, 1).data;
            const hex = "#" + ((1<<24)+(p[0]<<16)+(p[1]<<8)+p[2]).toString(16).slice(1);
            if(activeLayerIndex>-1) {
                if(pickTarget==='box') { layers[activeLayerIndex].color=hex; document.getElementById('boxColor').value=hex; }
                else if(pickTarget==='textBg') { layers[activeLayerIndex].bgColor=hex; document.getElementById('textBgColor').value=hex; }
            }
            isPicking=false; pickTarget=null; draw();
        }
        function updateFilter(k,v) { filters[k]=v; document.getElementById(`val-${k}`).innerText=v+'%'; draw(); }
        function toggleFilter(k) { filters[k]=filters[k]===0?100:0; draw(); }
        function toggleCanvasBg() { document.getElementById('canvasWrapper').classList.toggle('checkerboard'); }
        
        // --- OCR ---
        async function runOCR() {
            if(!img.src) return alert("Upload Image First");
            document.getElementById('ocrLoader').classList.remove('hidden');
            try {
                const res = await Tesseract.recognize(canvas.toDataURL());
                layers.push({type:'text', content:res.data.text, x:50, y:50, fontSize:30, fontFamily:"'Inter', sans-serif", color:'#ffffff', bgEnabled:true, bgColor:'#000000', w:300, h:200});
                activeLayerIndex=layers.length-1; draw(); updateUI();
            } catch(e){ alert("OCR Failed"); } finally { document.getElementById('ocrLoader').classList.add('hidden'); }
        }

        // --- AI Logic (Gemini & OpenAI) ---
        function openSettings() { document.getElementById('settingsModal').classList.remove('hidden'); }
        function closeSettings() { document.getElementById('settingsModal').classList.add('hidden'); }
        function saveSettings() {
            keys.gemini = document.getElementById('keyGemini').value;
            keys.openai = document.getElementById('keyOpenAI').value;
            localStorage.setItem('pm_gemini', keys.gemini);
            localStorage.setItem('pm_openai', keys.openai);
            closeSettings();
        }

        async function aiAction(type) {
            if(activeLayerIndex===-1 || layers[activeLayerIndex].type!=='text') return alert("Select Text Layer");
            const text = layers[activeLayerIndex].content;
            let prompt = "";
            if(type==='rewrite') prompt = "Rewrite this text to be better for social media (keep it similar length):";
            if(type==='translate') prompt = "Translate this text to Bengali (Bangla):";
            if(type==='grammar') prompt = "Fix grammar and spelling in this text:";
            if(type==='viral') prompt = "Make this text catchy and viral for Facebook/Instagram (add emojis):";
            
            const result = await callAI(prompt + ` "${text}"`);
            if(result) {
                layers[activeLayerIndex].content = result.replace(/^"|"$/g, ''); // remove quotes
                document.getElementById('textInput').value = layers[activeLayerIndex].content;
                draw();
            }
        }

        function quickPrompt(prompt) {
            document.getElementById('chatInput').value = prompt;
            sendChat();
        }

        async function sendChat() {
            const input = document.getElementById('chatInput');
            const msg = input.value;
            if(!msg) return;

            // UI
            const history = document.getElementById('chatHistory');
            history.innerHTML += `<div class="chat-bubble chat-user">${msg}</div>`;
            input.value = '';
            history.scrollTop = history.scrollHeight;

            document.getElementById('aiLoader').classList.remove('hidden');
            document.getElementById('aiStatusText').textContent = "AI is thinking...";

            // Context: Send Image if possible (Gemini only)
            const model = document.getElementById('aiModelSelect').value;
            let imageData = null;
            if (model === 'gemini' && img.src) {
                imageData = canvas.toDataURL('image/jpeg').split(',')[1];
            }

            const response = await callAI(msg, imageData, true);
            
            document.getElementById('aiLoader').classList.add('hidden');
            if(response) {
                const html = marked.parse(response);
                history.innerHTML += `<div class="chat-bubble chat-ai">${html}</div>`;
                history.scrollTop = history.scrollHeight;
            }
        }

        async function callAI(prompt, imageBase64 = null, isChat = false) {
            const modelType = document.getElementById('aiModelSelect').value;
            
            if (modelType === 'gemini') {
                if(!keys.gemini) { openSettings(); return null; }
                const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${keys.gemini}`;
                
                const parts = [{ text: prompt }];
                if (imageBase64) {
                    parts.unshift({ inline_data: { mime_type: "image/jpeg", data: imageBase64 } });
                }

                try {
                    const res = await fetch(url, {
                        method: 'POST', headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({ contents: [{ parts: parts }] })
                    });
                    const data = await res.json();
                    return data.candidates?.[0]?.content?.parts?.[0]?.text || "Error from Gemini.";
                } catch(e) { return "Connection Error with Gemini."; }

            } else {
                // OpenAI
                if(!keys.openai) { openSettings(); return null; }
                const url = "https://api.openai.com/v1/chat/completions";
                try {
                    const res = await fetch(url, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${keys.openai}`
                        },
                        body: JSON.stringify({
                            model: "gpt-3.5-turbo",
                            messages: [{ role: "user", content: prompt }]
                        })
                    });
                    const data = await res.json();
                    return data.choices?.[0]?.message?.content || "Error from OpenAI (Check Console/CORS).";
                } catch(e) { return "Connection Error with OpenAI. (Browser might block direct API calls, try Gemini)."; }
            }
        }

        function downloadImage(s) {
            if(!img.src)return; const l=document.createElement('a'); const c=document.createElement('canvas');
            c.width=canvas.width*s; c.height=canvas.height*s; const cx=c.getContext('2d'); cx.scale(s,s);
            cx.filter=`brightness(${filters.brightness}%) contrast(${filters.contrast}%) invert(${filters.invert}%) grayscale(${filters.grayscale}%)`;
            cx.drawImage(img,0,0); cx.filter='none';
            layers.forEach(l=>{
                if(l.type==='brush'){cx.lineCap='round';cx.lineJoin='round';cx.lineWidth=l.size;cx.strokeStyle=l.color;cx.beginPath();if(l.points.length>0){cx.moveTo(l.points[0].x,l.points[0].y);for(let i=1;i<l.points.length;i++)cx.lineTo(l.points[i].x,l.points[i].y);cx.stroke();}}
                else if(l.type==='box'){cx.fillStyle=l.color;cx.fillRect(l.x,l.y,l.w,l.h);}
                else if(l.type==='blur'){cx.save();cx.beginPath();cx.rect(l.x,l.y,l.w,l.h);cx.clip();cx.filter=`blur(${l.blur}px)`;cx.drawImage(img,0,0);cx.restore();}
                else if(l.type==='text'){cx.font=`${l.bold?'bold':''} ${l.fontSize}px ${l.fontFamily}`;cx.textBaseline='top';if(l.bgEnabled){cx.fillStyle=l.bgColor;cx.fillRect(l.x-5,l.y-5,l.w+10,l.h+10);}cx.fillStyle=l.color;l.content.split('\n').forEach((t,i)=>cx.fillText(t,l.x,l.y+(i*l.fontSize*1.2)));}
            });
            l.download=`PM-Ult-Export-${Date.now()}.png`; l.href=c.toDataURL('image/png', 0.9); l.click();
        }
    </script>
</body>
