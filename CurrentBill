<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🏠 বাসার ইলেকট্রিক লোড ক্যালকুলেটর</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'Segoe UI',Tahoma,sans-serif;background:#0f172a;color:#e2e8f0;min-height:100vh;}
.container{max-width:800px;margin:0 auto;padding:10px;}
h1{text-align:center;padding:15px;background:linear-gradient(135deg,#1e40af,#7c3aed);border-radius:15px;margin-bottom:15px;font-size:1.3em;color:#fff;text-shadow:1px 1px 3px rgba(0,0,0,.5);}
.section{background:#1e293b;border-radius:12px;padding:15px;margin-bottom:12px;border:1px solid #334155;}
.section-title{font-size:1.1em;font-weight:bold;color:#60a5fa;margin-bottom:10px;display:flex;align-items:center;gap:8px;cursor:pointer;user-select:none;}
.section-title .toggle-icon{transition:transform .3s;}
.section-title .toggle-icon.collapsed{transform:rotate(-90deg);}
.section-content{overflow:hidden;transition:max-height .3s ease;}
.item-row{background:#0f172a;border-radius:8px;padding:10px;margin-bottom:8px;border:1px solid #334155;}
.item-header{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:5px;}
.item-name{color:#fbbf24;font-weight:bold;font-size:.95em;}
.item-watts{color:#34d399;font-size:.85em;}
.input-group{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:8px;}
.input-group label{font-size:.8em;color:#94a3b8;}
.input-group input,.input-group select{background:#1e293b;border:1px solid #475569;color:#e2e8f0;border-radius:6px;padding:6px 8px;width:70px;font-size:.85em;text-align:center;}
.input-group input:focus,.input-group select:focus{outline:none;border-color:#60a5fa;box-shadow:0 0 5px rgba(96,165,250,.3);}
.item-result{text-align:right;color:#fb923c;font-weight:bold;font-size:.9em;margin-top:5px;}
.btn{padding:8px 16px;border:none;border-radius:8px;cursor:pointer;font-size:.85em;font-weight:bold;transition:all .2s;}
.btn-add{background:#22c55e;color:#fff;}
.btn-add:hover{background:#16a34a;}
.btn-remove{background:#ef4444;color:#fff;padding:5px 10px;font-size:.75em;}
.btn-remove:hover{background:#dc2626;}
.btn-print{background:linear-gradient(135deg,#2563eb,#7c3aed);color:#fff;width:100%;padding:12px;font-size:1em;margin-top:10px;}
.btn-print:hover{opacity:.9;}
.btn-reset{background:#64748b;color:#fff;width:100%;padding:10px;font-size:.9em;margin-top:5px;}
.summary-box{background:linear-gradient(135deg,#1e3a5f,#1e293b);border:2px solid #3b82f6;border-radius:12px;padding:15px;margin-top:15px;}
.summary-row{display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid #334155;font-size:.9em;}
.summary-row:last-child{border-bottom:none;}
.summary-row.total{font-size:1.1em;color:#fbbf24;font-weight:bold;border-top:2px solid #fbbf24;margin-top:5px;padding-top:10px;}
.summary-row.grand-total{font-size:1.2em;color:#22c55e;font-weight:bold;border-top:2px solid #22c55e;margin-top:5px;padding-top:10px;}
.custom-section{border:2px dashed #475569;border-radius:12px;padding:15px;margin-bottom:12px;}
.custom-input-row{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:8px;}
.custom-input-row input,.custom-input-row select{flex:1;min-width:60px;background:#1e293b;border:1px solid #475569;color:#e2e8f0;border-radius:6px;padding:8px;font-size:.85em;}
.slab-row{display:flex;gap:5px;align-items:center;margin-bottom:5px;flex-wrap:wrap;}
.slab-row input{background:#1e293b;border:1px solid #475569;color:#e2e8f0;border-radius:6px;padding:6px;width:80px;font-size:.85em;text-align:center;}
.slab-row span{font-size:.8em;color:#94a3b8;white-space:nowrap;}
.badge{display:inline-block;padding:2px 8px;border-radius:10px;font-size:.7em;font-weight:bold;}
.badge-fan{background:#3b82f6;color:#fff;}
.badge-light{background:#eab308;color:#000;}
.badge-ac{background:#06b6d4;color:#fff;}
.badge-fridge{background:#8b5cf6;color:#fff;}
.badge-other{background:#64748b;color:#fff;}
.ips-box{background:#1a1a2e;border:1px solid #7c3aed;border-radius:10px;padding:12px;margin-top:8px;}
.solar-box{background:#1a2e1a;border:1px solid #22c55e;border-radius:10px;padding:12px;margin-top:8px;}
.tab-bar{display:flex;gap:5px;overflow-x:auto;padding-bottom:8px;margin-bottom:10px;}
.tab-btn{padding:8px 14px;border:1px solid #475569;background:#1e293b;color:#94a3b8;border-radius:20px;font-size:.8em;cursor:pointer;white-space:nowrap;transition:all .2s;}
.tab-btn.active{background:#3b82f6;color:#fff;border-color:#3b82f6;}
.hidden{display:none;}
.preset-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:5px;margin-bottom:10px;}
.preset-btn{padding:6px;background:#0f172a;border:1px solid #475569;color:#e2e8f0;border-radius:6px;font-size:.75em;cursor:pointer;text-align:center;transition:all .2s;}
.preset-btn:hover{border-color:#60a5fa;background:#1e293b;}
.info-text{font-size:.75em;color:#64748b;margin-top:3px;}
.highlight{animation:glow 1s ease-in-out;}
@keyframes glow{0%,100%{box-shadow:none;}50%{box-shadow:0 0 15px rgba(59,130,246,.5);}}
.collapsible{overflow:hidden;transition:max-height .4s ease-out;max-height:2000px;}
.collapsible.collapsed{max-height:0;}
.category-total{background:#334155;border-radius:8px;padding:8px 12px;margin-top:8px;display:flex;justify-content:space-between;font-size:.85em;color:#fbbf24;}

@media print{
body{background:#fff!important;color:#000!important;font-size:12px;}
.container{max-width:100%;}
.section{background:#fff!important;border:1px solid #ccc!important;break-inside:avoid;}
.section-title{color:#1e40af!important;}
.item-row{background:#f8f8f8!important;border:1px solid #ddd!important;}
.item-name{color:#b45309!important;}
.item-watts{color:#047857!important;}
.item-result{color:#c2410c!important;}
.input-group input,.input-group select{background:#fff!important;border:1px solid #999!important;color:#000!important;}
.summary-box{background:#f0f7ff!important;border:2px solid #2563eb!important;}
.summary-row{color:#000!important;}
.summary-row.total{color:#b45309!important;}
.summary-row.grand-total{color:#047857!important;}
h1{background:#2563eb!important;-webkit-print-color-adjust:exact;print-color-adjust:exact;}
.btn-print,.btn-reset,.btn-add,.btn-remove,.tab-bar,.preset-grid,.no-print{display:none!important;}
.custom-input-row{display:none!important;}
.collapsible{max-height:none!important;}
.category-total{background:#eee!important;-webkit-print-color-adjust:exact;print-color-adjust:exact;}
.slab-row input{background:#fff!important;border:1px solid #999!important;color:#000!important;}
}
</style>
</head>
