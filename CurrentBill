// ==================== SOLAR CALCULATOR ====================
function calcSolar(){
let panelW = parseInt(document.getElementById('solarPanelWatt').value);
let panelCount = parseInt(document.getElementById('solarPanelCount').value) || 1;
let peakHours = parseFloat(document.getElementById('solarPeakHours').value);
let loss = parseFloat(document.getElementById('solarLoss').value);
let netMeter = document.getElementById('netMetering').value;
let hasBattery = document.getElementById('solarBattery').value;
let batAh = parseInt(document.getElementById('solarBatteryAh').value) || 0;
let batCount = parseInt(document.getElementById('solarBatteryCount').value) || 1;
let investment = parseInt(document.getElementById('solarInvestment').value) || 0;
let unitRate = parseFloat(document.getElementById('solarUnitRate').value) || 8;

let totalPanelW = panelW * panelCount;
let dailyGen = totalPanelW * peakHours * (1 - loss) / 1000; // kWh
let monthlyGen = dailyGen * 30;
let yearlyGen = dailyGen * 365;

let totalLoad = getTotalAll();
let monthlyConsumption = totalLoad.monthlyKWh;
let selfConsume = Math.min(monthlyGen, monthlyConsumption);
let excess = Math.max(0, monthlyGen - monthlyConsumption);

let monthlySaving = selfConsume * unitRate;
if(netMeter === 'yes') monthlySaving += excess * unitRate * 0.65; // net metering offset rate
let yearlySaving = monthlySaving * 12;
let paybackYears = yearlySaving > 0 ? investment / yearlySaving : 0;

let batStorageWh = hasBattery === 'yes' ? batAh * batCount * 12 * 0.5 * 0.8 : 0;

let html = `
<div class="summary-box" style="border-color:#22c55e;">
<h3 style="color:#4ade80;margin-bottom:10px;">☀️ সোলার ফলাফল</h3>
<div class="summary-row"><span>মোট প্যানেল ক্যাপাসিটি:</span><span>${totalPanelW}W (${(totalPanelW/1000).toFixed(2)} kW)</span></div>
<div class="summary-row"><span>দৈনিক উৎপাদন:</span><span>${dailyGen.toFixed(2)} kWh</span></div>
<div class="summary-row"><span>মাসিক উৎপাদন:</span><span>${monthlyGen.toFixed(1)} kWh</span></div>
<div class="summary-row"><span>বার্ষিক উৎপাদন:</span><span>${yearlyGen.toFixed(0)} kWh</span></div>
<div class="summary-row"><span>বাসার মাসিক খরচ:</span><span>${monthlyConsumption.toFixed(1)} kWh</span></div>
<div class="summary-row"><span>সোলার দিয়ে কভার:</span><span>${monthlyConsumption > 0 ? ((selfConsume/monthlyConsumption)*100).toFixed(1) : 0}%</span></div>
${netMeter === 'yes' ? `<div class="summary-row"><span>এক্সেস (নেট মিটার):</span><span>${excess.toFixed(1)} kWh/মাস</span></div>` : ''}
${hasBattery === 'yes' ? `<div class="summary-row"><span>ব্যাটারি স্টোরেজ:</span><span>${(batStorageWh/1000).toFixed(2)} kWh</span></div>` : ''}
<div class="summary-row total"><span>💰 মাসিক সেভিং:</span><span>৳${monthlySaving.toFixed(0)}</span></div>
<div class="summary-row"><span>বার্ষিক সেভিং:</span><span>৳${yearlySaving.toFixed(0)}</span></div>
${investment > 0 ? `<div class="summary-row grand-total"><span>🔄 পেব্যাক পিরিয়ড:</span><span>${paybackYears.toFixed(1)} বছর</span></div>` : ''}
</div>

<div class="summary-box" style="margin-top:10px;border-color:#22c55e;">
<h3 style="color:#4ade80;margin-bottom:10px;">📋 বিভিন্ন প্যানেল কম্বিনেশন</h3>
${[1,2,3,4,5,6,8,10].map(n => {
let d = panelW * n * peakHours * (1-loss) / 1000;
let m = d * 30;
return `<div class="summary-row"><span>${n}× ${panelW}W (${panelW*n}W):</span><span>${d.toFixed(2)} kWh/দিন | ${m.toFixed(0)} kWh/মাস</span></div>`;
}).join('')}
</div>`;

document.getElementById('solarResult').innerHTML = html;
}

// ==================== BILL CALCULATOR ====================
function calcBill(){
let total = getTotalAll();
let billingDays = parseInt(document.getElementById('billingDays').value) || 30;
let manualUnits = document.getElementById('manualUnits').value;
let totalUnits;
if(manualUnits && parseFloat(manualUnits) > 0){
totalUnits = parseFloat(manualUnits);
} else {
totalUnits = total.dailyKWh * billingDays;
}

let demandCharge = parseFloat(document.getElementById('demandCharge').value) || 0;
let connectedLoad = parseFloat(document.getElementById('connectedLoad').value) || 0;
let meterRent = parseFloat(document.getElementById('meterRent').value) || 0;
let serviceCharge = parseFloat(document.getElementById('serviceCharge').value) || 0;
let vatPct = parseFloat(document.getElementById('vatPercent').value) || 0;
let surchargePct = parseFloat(document.getElementById('surchargePercent').value) || 0;
let taxPct = parseFloat(document.getElementById('taxPercent').value) || 0;
let rebate = parseFloat(document.getElementById('rebateAmount').value) || 0;

// Calculate slab-wise
let remainingUnits = totalUnits;
let energyCharge = 0;
let slabDetails = [];

for(let s of slabs){
if(remainingUnits <= 0) break;
let slabUnits = Math.min(remainingUnits, s.to - s.from + 1);
if(s.from === 0) slabUnits = Math.min(remainingUnits, s.to + 1);
let slabCost = slabUnits * s.rate;
energyCharge += slabCost;
slabDetails.push({from:s.from, to:s.to, units:slabUnits, rate:s.rate, cost:slabCost});
remainingUnits -= slabUnits;
}

let demandTotal = demandCharge * connectedLoad;
let subTotal = energyCharge + demandTotal + meterRent + serviceCharge;
let vat = subTotal * vatPct / 100;
let surcharge = subTotal * surchargePct / 100;
let tax = subTotal * taxPct / 100;
let grandTotal = subTotal + vat + surcharge + tax - rebate;
let avgRate = totalUnits > 0 ? grandTotal / totalUnits : 0;

let html = `
<div class="summary-box" style="border-color:#fbbf24;">
<h3 style="color:#fbbf24;margin-bottom:10px;">💰 বিদ্যুৎ বিল বিস্তারিত</h3>
<div class="summary-row"><span>মোট ইউনিট:</span><span>${totalUnits.toFixed(2)} kWh (${billingDays} দিন)</span></div>
<hr style="border-color:#334155;margin:8px 0;">
<h4 style="color:#60a5fa;margin-bottom:5px;">📊 স্ল্যাব অনুযায়ী:</h4>
${slabDetails.map((s,i) => `
<div class="summary-row">
<span>স্ল্যাব ${i+1} (${s.from}-${s.to}): ${s.units.toFixed(2)} ইউনিট × ৳${s.rate}</span>
<span>৳${s.cost.toFixed(2)}</span>
</div>`).join('')}
<div class="summary-row" style="color:#fb923c;font-weight:bold;"><span>এনার্জি চার্জ:</span><span>৳${energyCharge.toFixed(2)}</span></div>
<hr style="border-color:#334155;margin:8px 0;">
<div class="summary-row"><span>ডিমান্ড চার্জ (${connectedLoad}kW × ৳${demandCharge}):</span><span>৳${demandTotal.toFixed(2)}</span></div>
<div class="summary-row"><span>মিটার ভাড়া:</span><span>৳${meterRent.toFixed(2)}</span></div>
${serviceCharge > 0 ? `<div class="summary-row"><span>সার্ভিস চার্জ:</span><span>৳${serviceCharge.toFixed(2)}</span></div>` : ''}
<div class="summary-row" style="font-weight:bold;"><span>সাব-টোটাল:</span><span>৳${subTotal.toFixed(2)}</span></div>
<hr style="border-color:#334155;margin:8px 0;">
${vatPct > 0 ? `<div class="summary-row"><span>ভ্যাট (${vatPct}%):</span><span>৳${vat.toFixed(2)}</span></div>` : ''}
${surchargePct > 0 ? `<div class="summary-row"><span>সারচার্জ (${surchargePct}%):</span><span>৳${surcharge.toFixed(2)}</span></div>` : ''}
${taxPct > 0 ? `<div class="summary-row"><span>ট্যাক্স/ডিউটি (${taxPct}%):</span><span>৳${tax.toFixed(2)}</span></div>` : ''}
${rebate > 0 ? `<div class="summary-row" style="color:#22c55e;"><span>রিবেট/ছাড়:</span><span>-৳${rebate.toFixed(2)}</span></div>` : ''}
<div class="summary-row grand-total"><span>🧾 মোট বিল:</span><span>৳${grandTotal.toFixed(2)}</span></div>
<div class="summary-row"><span>গড় রেট/ইউনিট:</span><span>৳${avgRate.toFixed(2)}/kWh</span></div>
<div class="summary-row"><span>দৈনিক গড় খরচ:</span><span>৳${(grandTotal/billingDays).toFixed(2)}/দিন</span></div>
</div>`;

document.getElementById('billResult').innerHTML = html;
return {totalUnits, energyCharge, demandTotal, meterRent, serviceCharge, vat, surcharge, tax, rebate, subTotal, grandTotal, avgRate, slabDetails, billingDays};
}

