<script>
// ==================== DATA STORE ====================
let allItems = {};
const categories = ['fan','light','ac','fridge','tv','computer','kitchen','wash','pump','heater','security','custom'];
const catNames = {fan:'ফ্যান',light:'লাইট',ac:'এসি',fridge:'ফ্রিজ',tv:'টিভি',computer:'কম্পিউটার',kitchen:'রান্নাঘর',wash:'ওয়াশিং',pump:'পাম্প',heater:'হিটার',security:'সিকিউরিটি',custom:'কাস্টম'};
const catIcons = {fan:'🌀',light:'💡',ac:'❄️',fridge:'🧊',tv:'📺',computer:'💻',kitchen:'🍳',wash:'🧺',pump:'💧',heater:'🔥',security:'🔒',custom:'➕'};
let itemCounter = 0;

categories.forEach(c => allItems[c] = []);

// ==================== SLAB INIT ====================
let slabs = [
{from:0,to:75,rate:4.19},
{from:76,to:200,rate:5.72},
{from:201,to:300,rate:6.00},
{from:301,to:400,rate:6.34},
{from:401,to:500,rate:9.94},
{from:501,to:600,rate:10.40},
{from:601,to:99999,rate:12.57}
];

function initSlabs(){
let c = document.getElementById('slabContainer');
c.innerHTML = '';
slabs.forEach((s,i) => {
c.innerHTML += `
<div class="slab-row" id="slab-${i}">
<span>স্ল্যাব ${i+1}:</span>
<input type="number" value="${s.from}" onchange="slabs[${i}].from=+this.value;calcBill();" placeholder="থেকে">
<span>-</span>
<input type="number" value="${s.to}" onchange="slabs[${i}].to=+this.value;calcBill();" placeholder="পর্যন্ত">
<span>ইউনিট @</span>
<input type="number" value="${s.rate}" step="0.01" onchange="slabs[${i}].rate=+this.value;calcBill();" placeholder="৳/unit">
<span>৳</span>
<button class="btn btn-remove no-print" onclick="slabs.splice(${i},1);initSlabs();calcBill();">✕</button>
</div>`;
});
}

function addSlab(){
let last = slabs.length > 0 ? slabs[slabs.length-1].to + 1 : 0;
slabs.push({from:last, to:last+100, rate:8.00});
initSlabs();
}

// ==================== ITEM MANAGEMENT ====================
function addItem(cat, name, watt){
let id = 'item_' + (++itemCounter);
allItems[cat].push({id, name, watt, qty:1, hours:8});
renderItems(cat);
recalcAll();
}

function addCustomItem(){
let name = document.getElementById('customName').value.trim();
let watt = parseInt(document.getElementById('customWatt').value) || 0;
let cat = document.getElementById('customCategory').value;
if(!name){alert('নাম লিখুন!');return;}
if(watt <= 0){alert('ওয়াট দিন!');return;}
addItem(cat, name, watt);
document.getElementById('customName').value = '';
document.getElementById('customWatt').value = '';
}

function removeItem(cat, id){
allItems[cat] = allItems[cat].filter(i => i.id !== id);
renderItems(cat);
recalcAll();
}

function updateItem(cat, id, field, val){
let item = allItems[cat].find(i => i.id === id);
if(item){
item[field] = field === 'name' ? val : parseFloat(val) || 0;
}
recalcAll();
}

function renderItems(cat){
let container = document.getElementById(cat + 'Items');
if(!container) return;
let html = '';
allItems[cat].forEach(item => {
let daily = (item.watt * item.qty * item.hours) / 1000;
let monthly = daily * 30;
html += `
<div class="item-row highlight" id="${item.id}">
<div class="item-header">
<span class="item-name">${item.name}</span>
<span class="item-watts">${item.watt}W × ${item.qty} = ${item.watt * item.qty}W</span>
<button class="btn btn-remove no-print" onclick="removeItem('${cat}','${item.id}')">✕ মুছুন</button>
</div>
<div class="input-group">
<div>
<label>সংখ্যা:</label>
<input type="number" value="${item.qty}" min="1" max="100" onchange="updateItem('${cat}','${item.id}','qty',this.value)" style="width:55px;">
</div>
<div>
<label>ওয়াট:</label>
<input type="number" value="${item.watt}" min="0" onchange="updateItem('${cat}','${item.id}','watt',this.value)" style="width:65px;">
</div>
<div>
<label>ঘণ্টা/দিন:</label>
<input type="number" value="${item.hours}" min="0" max="24" step="0.5" onchange="updateItem('${cat}','${item.id}','hours',this.value)" style="width:60px;">
</div>
</div>
<div class="item-result">
দৈনিক: ${daily.toFixed(3)} kWh | মাসিক: ${monthly.toFixed(2)} kWh
</div>
</div>`;
});
container.innerHTML = html;
}

// ==================== CALCULATIONS ====================
function getCatTotals(cat){
let totalW = 0, dailyKWh = 0;
allItems[cat].forEach(item => {
totalW += item.watt * item.qty;
dailyKWh += (item.watt * item.qty * item.hours) / 1000;
});
return {totalW, dailyKWh, monthlyKWh: dailyKWh * 30};
}

function getTotalAll(){
let totalW = 0, dailyKWh = 0;
categories.forEach(cat => {
let t = getCatTotals(cat);
totalW += t.totalW;
dailyKWh += t.dailyKWh;
});
return {totalW, dailyKWh, monthlyKWh: dailyKWh * 30};
}

function recalcAll(){
categories.forEach(cat => {
let t = getCatTotals(cat);
let el = document.getElementById(cat + 'TotalW');
if(el) el.textContent = `${t.totalW}W | ${t.dailyKWh.toFixed(2)} kWh/দিন | ${t.monthlyKWh.toFixed(1)} kWh/মাস`;
});
calcIPS();
calcSolar();
calcBill();
autoSave();
}

// ==================== IPS CALCULATOR ====================
function calcIPSFromPercent(){
let pct = parseFloat(document.getElementById('ipsLoadPercent').value) || 0;
let total = getTotalAll();
let load = Math.round(total.totalW * pct / 100);
document.getElementById('ipsLoad').value = load;
calcIPS();
}

function calcIPS(){
let ah = parseInt(document.getElementById('batteryAh').value);
let count = parseInt(document.getElementById('batteryCount').value) || 1;
let volt = parseInt(document.getElementById('batteryVolt').value);
let conn = document.getElementById('batteryConnection').value;
let chargingAmp = parseInt(document.getElementById('chargingAmp').value);
let eff = parseFloat(document.getElementById('ipsEfficiency').value);
let dod = parseFloat(document.getElementById('ipsDOD').value);
let load = parseInt(document.getElementById('ipsLoad').value) || 0;

let totalAh, systemVolt;
if(conn === 'parallel'){
totalAh = ah * count;
systemVolt = volt;
} else {
totalAh = ah;
systemVolt = volt * count;
}

let totalWh = totalAh * systemVolt;
let usableWh = totalWh * dod * eff;
let backupHours = load > 0 ? usableWh / load : 0;
let chargeTime = totalAh / chargingAmp * 1.2; // 20% overhead
let chargingWatt = chargingAmp * systemVolt;
let chargingKWh = (chargingWatt * chargeTime) / 1000;
let monthlyChargingKWh = chargingKWh * (24 / (backupHours + chargeTime)) * 0.5 * 30; // rough estimate

let html = `
