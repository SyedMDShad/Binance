        document.addEventListener('DOMContentLoaded', () => {
            const chapterNav = document.getElementById('chapter-nav');
            const contentArea = document.getElementById('content-area');
            const chapters = contentArea.querySelectorAll('.chapter-content');

            function createQuizItem(item, index) {
                return `
                    <div class="quiz-item p-4 border rounded-lg bg-white/50 shadow-sm">
                        <p class="text-gray-800 font-medium mb-2">${index + 1}. ${item.q}</p>
                        <div class="flex flex-col sm:flex-row sm:items-center gap-2">
                            <input type="text" class="quiz-input w-full p-2 rounded-md" placeholder="আপনার উত্তর লিখুন...">
                            <div class="flex items-center gap-2 flex-shrink-0">
                                <button class="check-btn bg-indigo-500 text-white px-4 py-2 rounded-md hover:bg-indigo-600 transition-colors">Check</button>
                                <button class="show-answer-btn bg-gray-500 text-white px-4 py-2 rounded-md hover:bg-gray-600 transition-colors">Answer</button>
                            </div>
                        </div>
                        <p class="feedback mt-2 text-sm font-medium"></p>
                        <p class="correct-answer hidden mt-2 text-sm text-green-700 bg-green-100 p-2 rounded-md">সঠিক উত্তর: <span class="font-bold">${item.a}</span></p>
                    </div>
                `;
            }
            
            for (const chapterId in quizData) {
                const container = document.querySelector(`#${chapterId} .quiz-container`);
                if (container) {
                    container.innerHTML = quizData[chapterId].map(createQuizItem).join('');
                }
            }

            // Navigation logic
            chapterNav.addEventListener('click', (e) => {
                const button = e.target.closest('button');
                const title = e.target.closest('.nav-group-title, .nav-subgroup-title');

                if (button && button.dataset.chapter) {
                    const targetChapterId = button.dataset.chapter;
                    chapterNav.querySelectorAll('button').forEach(btn => btn.classList.remove('active'));
                    button.classList.add('active');
                    chapters.forEach(chapter => {
                        chapter.classList.toggle('hidden', chapter.id !== targetChapterId);
                    });
                }

                if (title) {
                    title.classList.toggle('collapsed');
                    const content = title.nextElementSibling;
                    content.classList.toggle('collapsed');
                }
            });

            // Quiz logic
            contentArea.addEventListener('click', (e) => {
                const quizItem = e.target.closest('.quiz-item');
                if (!quizItem) return;

                const input = quizItem.querySelector('.quiz-input');
                const feedback = quizItem.querySelector('.feedback');
                const correctAnswerEl = quizItem.querySelector('.correct-answer');
                const correctAnswer = correctAnswerEl.querySelector('span').textContent.trim();
                
                if (e.target.classList.contains('check-btn')) {
                    const userAnswer = input.value.trim();
                    const normalizedUserAnswer = userAnswer.replace(/[.,?।]/g, '').toLowerCase();
                    const normalizedCorrectAnswer = correctAnswer.replace(/[.,?।]/g, '').toLowerCase();
                    
                    input.classList.remove('correct', 'incorrect');
                    feedback.classList.remove('text-green-600', 'text-red-600', 'text-yellow-600');

                    if (userAnswer === "") {
                        feedback.textContent = "অনুগ্রহ করে আপনার উত্তর লিখুন।";
                        feedback.className = "feedback mt-2 text-sm font-medium text-yellow-600";
                        return;
                    }

                    if (normalizedUserAnswer === normalizedCorrectAnswer) {
                        feedback.textContent = "সঠিক হয়েছে! 🎉";
                        feedback.className = "feedback mt-2 text-sm font-medium text-green-600";
                        input.classList.add('correct');
                    } else {
                        feedback.textContent = "আবার চেষ্টা করুন।";
                        feedback.className = "feedback mt-2 text-sm font-medium text-red-600";
                        input.classList.add('incorrect');
                    }
                }

                if (e.target.classList.contains('show-answer-btn')) {
                    correctAnswerEl.classList.toggle('hidden');
                }
            });
        });
    </script>
